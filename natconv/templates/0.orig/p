FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    heater
    {
        type            calculated;
        value           uniform 1e5;
    }

    farfield
    {
        type            calculated;
        value           uniform 1e5;
    }
}

